{
  "name": "at-search",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Decentralized search and discovery layer for AT Protocol objects",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "seed": "pnpm --filter @atsearch/indexer run seed",
    "demo": "bash scripts/run-demo.sh"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
