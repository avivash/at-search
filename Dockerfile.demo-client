FROM oven/bun:1 AS build
WORKDIR /app

COPY packages/demo-client ./packages/demo-client
WORKDIR /app/packages/demo-client

RUN bun install --frozen-lockfile || bun install
RUN bun run build

FROM nginx:1.27-alpine
COPY --from=build /app/packages/demo-client/build /usr/share/nginx/html
COPY deploy/nginx-demo.conf /etc/nginx/nginx.conf

EXPOSE 80

