[0.515, "o", "{\r\n  \"lexicon\": 1,\r\n  \"id\": \"at.functions.recipe\",\r\n  \"defs\": {\r\n    \"main\": {\r\n      \"type\": \"record\",\r\n      \"description\": \"A recipe — invented on the spot to prove AT Search can index a lexicon it has never seen.\",\r\n      \"key\": \"any\",\r\n      \"record\": {\r\n        \"type\": \"object\",\r\n        \"required\": [\"title\", \"steps\"],\r\n        \"properties\": {\r\n          \"title\": {\r\n            \"type\": \"string\",\r\n            \"description\": \"Name of the dish\",\r\n            \"maxLength\": 200\r\n          },\r\n          \"steps\": {\r\n            \"type\": \"string\",\r\n            \"description\": \"How to make it\",\r\n            \"maxLength\": 20000\r\n          },\r\n"]
