# Indexer
#
# docker-compose (indexer): firehose source — must appear in compose `environment` (set here or in shell when compose runs).
# ATSEARCH_MODE=firehose
# Local relay (default in compose): ATSEARCH_FIREHOSE_URL=http://relay:2470
# Global discovery (indexer only; high volume): ATSEARCH_FIREHOSE_URL=https://bsky.network
# ATSEARCH_FIREHOSE_COLLECTIONS=at.functions.metadata
#
# Poll mode (no relay): poll specific DIDs from a PDS.
ATSEARCH_MODE=poll
ATSEARCH_PDS_URL=https://bsky.social
ATSEARCH_HANDLE=your-handle.bsky.social
ATSEARCH_PASSWORD=your-app-password
ATSEARCH_POLL_DIDS=did:plc:yourDid
ATSEARCH_POLL_COLLECTIONS=at.functions.metadata,com.example.thing
ATSEARCH_DHT_BOOTSTRAP=/ip4/127.0.0.1/tcp/8001/p2p/PEER_ID
ATSEARCH_HTTP_PORT=3001
ATSEARCH_DB_PATH=./data/indexer.db
ATSEARCH_NODE_KEY=

# Jetstream mode — network-wide JSON relay; the practical path for
# cross-lexicon coverage (pairs with ATSEARCH_LEXICON_MODE=auto below).
# ATSEARCH_MODE=jetstream
# ATSEARCH_JETSTREAM_URL=wss://jetstream2.us-west.bsky.network

# Lexicon handling (cross-lexicon indexing). auto = resolve schemas at
# runtime and triage collections (default); curated = fixed lists only.
# ATSEARCH_LEXICON_MODE=auto
# ATSEARCH_LEXICON_ALLOWLIST=
# ATSEARCH_LEXICON_DENYLIST=

# Query node — Microcosm + XRPC (see README)
USE_MICROCOSM=true
MICROCOSM_SLINGSHOT_BASE_URL=https://slingshot.microcosm.blue
MICROCOSM_CONSTELLATION_BASE_URL=https://constellation.microcosm.blue
FALLBACK_ATPROTO_XRPC_BASE_URL=https://public.api.bsky.app
APP_USER_AGENT=at-search-demo/0.1 (your-name; +https://your-project)

# Optional: allow a public UI to submit PDS crawl requests (server-side; rate limited).
# ATSEARCH_RELAY_ADMIN_URL=http://relay:2470
# ATSEARCH_RELAY_ADMIN_PASSWORD=change-me
# ATSEARCH_CRAWL_WINDOW_MS=60000
# ATSEARCH_CRAWL_MAX_PER_WINDOW=6

# ATSEARCH_DHT_BOOTSTRAP=/ip4/127.0.0.1/tcp/8001/p2p/PEER_ID
# ATSEARCH_HTTP_PORT=3002
# ATSEARCH_INDEXER_URLS=http://localhost:3001

# Demo Client
VITE_QUERY_API_URL=http://localhost:3002

# docker compose only — host publish for query-node (host:container is host:3002 inside)
# ATSEARCH_QUERY_HOSTPORT=127.0.0.1:13002

# AT Functions API on the same compose stack (requires ../at-functions checkout).
# COMPOSE_PROFILES=functions
# ATFUNCTIONS_HOSTPORT=127.0.0.1:13000
# ATFUNCTIONS_CORS_ORIGINS=
#
# Second stack on same host (use a different COMPOSE_PROJECT_NAME + unique ports):
# COMPOSE_PROJECT_NAME=atsearch-public
# ATSEARCH_RELAY_HTTP_HOSTPORT=127.0.0.1:22470
# ATSEARCH_RELAY_WS_HOSTPORT=127.0.0.1:22471
# ATSEARCH_QUERY_HOSTPORT=127.0.0.1:23002
# ATSEARCH_WEB_HOSTPORT=28080
