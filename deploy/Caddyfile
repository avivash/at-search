{
	# Enable on-disk cert storage and be explicit about protocols.
	servers {
		protocols h1 h2
	}

	# This service is commonly run behind Nginx/Cloudflare for TLS.
	# Disable Caddy's automatic HTTPS redirects/cert management to avoid redirect loops.
	auto_https off
}

# If you're terminating TLS in front (e.g. with Nginx), force HTTP here to
# avoid Caddy auto-redirecting to HTTPS and creating redirect loops.
http://{$ATSEARCH_PUBLIC_HOSTNAME:localhost} {
	encode zstd gzip

	@api path /api/* 
	handle @api {
		rewrite * {path.1}
		reverse_proxy {$ATSEARCH_QUERY_UPSTREAM:http://query-node:3002}
	}

	# Static demo client
	root * /usr/share/caddy
	try_files {path} /index.html
	file_server
}

